{
    "name": "synthwave-84-auto-glow",
    "displayName": "SynthWave '84 Auto-Glow (Fork)",
    "description": "Synthwave-inspired theme with auto-restore Neon glow after VS Code updates. Fork of RobbOwen.synthwave-vscode (MIT).",
    "version": "0.2.0",
    "author": "Robb Owen",
    "publisher": "horangelmillan",
    "icon": "icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/horangelmillan/synthwave-84-auto-glow"
    },
    "engines": {
        "vscode": "^1.33.0"
    },
    "extensionKind": [
        "ui"
    ],
    "keywords": [
        "retro",
        "80s"
    ],
    "categories": [
        "Themes"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onCommand:synthwave84.enableNeon",
        "onCommand:synthwave84.disableNeon"
    ],
    "main": "./src/extension.js",
    "contributes": {
        "themes": [
            {
                "label": "SynthWave '84",
                "uiTheme": "vs-dark",
                "path": "./themes/synthwave-color-theme.json"
            }
        ],
        "commands": [
            {
                "command": "synthwave84.enableNeon",
                "title": "Synthwave '84: Enable Neon Dreams"
            },
            {
                "command": "synthwave84.disableNeon",
                "title": "Synthwave '84: Disable Neon Dreams"
            }
        ],
        "configuration": {
            "title": "Synthwave '84",
            "properties": {
                "synthwave84.brightness": {
                    "type": "number",
                    "default": 0.45,
                    "description": "Set the brightness value for the glow effect. 0.0 is fully transparent and 1.0 is fully bright"
                },
                "synthwave84.disableGlow": {
                    "type": "boolean",
                    "default": false,
                    "description": "Disable the glow effect, but show Synthwave '84 editor chrome updates"
                },
                "synthwave84.autoEnableOnStartup": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically re-apply Neon Dreams after a VS Code update wipes the workbench HTML patch."
                }
            }
        }
    }
}
